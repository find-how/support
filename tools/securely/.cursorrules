#### **`src/fastcgi.rs`**

```rust
// src/fastcgi.rs

use bytes::{Buf, BufMut, BytesMut};
use std::collections::HashMap;

// FastCGI record types
pub const FCGI_VERSION_1: u8 = 1;
pub const FCGI_BEGIN_REQUEST: u8 = 1;
pub const FCGI_ABORT_REQUEST: u8 = 2;
pub const FCGI_END_REQUEST: u8 = 3;
pub const FCGI_PARAMS: u8 = 4;
pub const FCGI_STDIN: u8 = 5;
pub const FCGI_STDOUT: u8 = 6;
pub const FCGI_STDERR: u8 = 7;
pub const FCGI_DATA: u8 = 8;
pub const FCGI_GET_VALUES: u8 = 9;
pub const FCGI_GET_VALUES_RESULT: u8 = 10;
pub const FCGI_UNKNOWN_TYPE: u8 = 11;

// Roles
pub const FCGI_RESPONDER: u16 = 1;

// Protocol statuses
pub const FCGI_REQUEST_COMPLETE: u8 = 0;
pub const FCGI_CANT_MPX_CONN: u8 = 1;
pub const FCGI_OVERLOADED: u8 = 2;
pub const FCGI_UNKNOWN_ROLE: u8 = 3;

// FastCGI Record Header
#[derive(Debug, Clone)]
pub struct FcgiRecordHeader {
    pub version: u8,
    pub type_: u8,
    pub request_id: u16,
    pub content_length: u16,
    pub padding_length: u8,
    pub reserved: u8,
}

impl FcgiRecordHeader {
    pub fn from_bytes(bytes: &[u8]) -> Option<Self> {
        if bytes.len() < 8 {
            return None;
        }
        Some(Self {
            version: bytes[0],
            type_: bytes[1],
            request_id: u16::from_be_bytes([bytes[2], bytes[3]]),
            content_length: u16::from_be_bytes([bytes[4], bytes[5]]),
            padding_length: bytes[6],
            reserved: bytes[7],
        })
    }

    pub fn to_bytes(&self) -> [u8; 8] {
        let mut buf = BytesMut::with_capacity(8);
        buf.put_u8(self.version);
        buf.put_u8(self.type_);
        buf.put_u16(self.request_id.to_be());
        buf.put_u16(self.content_length.to_be());
        buf.put_u8(self.padding_length);
        buf.put_u8(self.reserved);
        let bytes = buf.split().freeze();
        let mut array = [0u8; 8];
        array.copy_from_slice(&bytes);
        array
    }
}

// FastCGI Request
#[derive(Debug)]
pub struct FcgiRequest {
    pub header: FcgiRecordHeader,
    pub content: Vec<u8>,
}

// FastCGI Response Builder
pub struct FcgiResponse {
    pub header: FcgiRecordHeader,
    pub content: Vec<u8>,
}

impl FcgiResponse {
    pub fn new(version: u8, type_: u8, request_id: u16, content: Vec<u8>) -> Self {
        Self {
            header: FcgiRecordHeader {
                version,
                type_,
                request_id,
                content_length: content.len() as u16,
                padding_length: 0,
                reserved: 0,
            },
            content,
        }
    }

    pub fn to_bytes(&self) -> BytesMut {
        let mut buf = BytesMut::with_capacity(8 + self.content.len());
        buf.put(&self.header.to_bytes()[..]);
        buf.put_slice(&self.content);
        buf
    }
}

// Helper function to parse FastCGI parameters
pub fn parse_params(content: &[u8]) -> HashMap<String, String> {
    let mut params = HashMap::new();
    let mut i = 0;
    while i < content.len() {
        // Name length
        let name_len = if content[i] & 0x80 == 0 {
            content[i] as usize
        } else {
            ((content[i] & 0x7F) as usize) << 24
                | (content[i + 1] as usize) << 16
                | (content[i + 2] as usize) << 8
                | (content[i + 3] as usize)
        };
        i += if content[i] & 0x80 == 0 { 1 } else { 4 };

        // Value length
        let value_len = if content[i] & 0x80 == 0 {
            content[i] as usize
        } else {
            ((content[i] & 0x7F) as usize) << 24
                | (content[i + 1] as usize) << 16
                | (content[i + 2] as usize) << 8
                | (content[i + 3] as usize)
        };
        i += if content[i] & 0x80 == 0 { 1 } else { 4 };

        // Extract name and value
        let name = String::from_utf8_lossy(&content[i..i + name_len]).to_string();
        i += name_len;
        let value = String::from_utf8_lossy(&content[i..i + value_len]).to_string();
        i += value_len;

        params.insert(name, value);
    }
    params
}
```

#### **Explanation**

- **`FcgiRecordHeader`**: Parses and serializes FastCGI headers.
- **`FcgiResponse`**: Helps in constructing FastCGI responses.
- **`parse_params`**: Converts FastCGI parameter bytes into a `HashMap`.

---

#### **`src/actor.rs`**

```rust
// src/actor.rs

use actix::prelude::*;
use tokio::process::Command;
use std::collections::HashMap;
use crate::fastcgi::{ExecutePhp, FcgiResponse, FCGI_VERSION_1, FCGI_STDOUT, FCGI_STDERR, FCGI_END_REQUEST};
use log::{info, error};

// Define the message that the actor will handle
pub struct ExecutePhp {
    pub script: String,
    pub params: HashMap<String, String>,
}

impl Message for ExecutePhp {
    type Result = Result<String, String>;
}

// Define the actor
pub struct PhpExecutor;

impl PhpExecutor {
    pub fn new() -> Self {
        PhpExecutor
    }
}

impl Actor for PhpExecutor {
    type Context = Context<Self>;
}

// Handler for ExecutePhp message
impl Handler<ExecutePhp> for PhpExecutor {
    type Result = ResponseActFuture<Self, Result<String, String>>;

    fn handle(&mut self, msg: ExecutePhp, _: &mut Context<Self>) -> Self::Result {
        let script = msg.script.clone();
        let params = msg.params.clone();

        Box::pin(async move {
            // Prepare environment variables for PHP
            let mut cmd = Command::new("php");
            cmd.arg(&script);

            for (key, value) in params.iter() {
                cmd.env(key, value);
            }

            // Execute the PHP script
            match cmd.output().await {
                Ok(output) => {
                    if output.status.success() {
                        let stdout = String::from_utf8_lossy(&output.stdout).to_string();
                        Ok(stdout)
                    } else {
                        let stderr = String::from_utf8_lossy(&output.stderr).to_string();
                        Err(stderr)
                    }
                }
                Err(e) => Err(e.to_string()),
            }
        }.into_actor(self))
    }
}
```

#### **Explanation**

- **`ExecutePhp` Message**: Contains the PHP script path and parameters.
- **`PhpExecutor` Actor**: Handles `ExecutePhp` messages by invoking the PHP interpreter as a subprocess, passing parameters as environment variables, and capturing the output.

---

#### **`src/worker.rs`**

```rust
// src/worker.rs

use actix::prelude::*;
use tokio::net::UnixStream;
use tokio::io::{AsyncReadExt, AsyncWriteExt};
use bytes::BytesMut;
use log::{info, error};
use crate::fastcgi::{FcgiRecordHeader, FcgiResponse, FCGI_VERSION_1, FCGI_STDOUT, FCGI_END_REQUEST, FCGI_UNKNOWN_TYPE, parse_params};
use crate::actor::{ExecutePhp, PhpExecutor};
use std::collections::HashMap;

// Message to handle a new FastCGI connection
pub struct HandleConnection {
    pub stream: UnixStream,
}

impl Message for HandleConnection {
    type Result = ();
}

// Define the Worker Actor
pub struct Worker {
    php_executor: Addr<PhpExecutor>,
}

impl Worker {
    pub fn new(php_executor: Addr<PhpExecutor>) -> Self {
        Worker { php_executor }
    }
}

impl Actor for Worker {
    type Context = Context<Self>;
}

// Handler for HandleConnection message
impl Handler<HandleConnection> for Worker {
    type Result = ResponseActFuture<Self, ()>;

    fn handle(&mut self, msg: HandleConnection, _: &mut Context<Self>) -> Self::Result {
        let stream = msg.stream;
        let php_executor = self.php_executor.clone();

        Box::pin(async move {
            let mut stream = stream;
            let mut buffer = [0u8; 8];

            // Read FastCGI header
            if let Err(e) = stream.read_exact(&mut buffer).await {
                error!("Failed to read FastCGI header: {}", e);
                return;
            }

            let header = match FcgiRecordHeader::from_bytes(&buffer) {
                Some(h) => h,
                None => {
                    error!("Invalid FastCGI header");
                    return;
                }
            };

            // Only handle FCGI_PARAMS for simplicity
            if header.type_ != crate::fastcgi::FCGI_PARAMS {
                error!("Unsupported FastCGI type: {}", header.type_);
                let response = FcgiResponse::new(
                    FCGI_VERSION_1,
                    crate::fastcgi::FCGI_UNKNOWN_TYPE,
                    header.request_id,
                    Vec::new(),
                );
                if let Err(e) = stream.write_all(&response.to_bytes()).await {
                    error!("Failed to write FCGI_UNKNOWN_TYPE: {}", e);
                }
                return;
            }

            // Read parameters
            let mut params = vec![0u8; header.content_length as usize];
            if let Err(e) = stream.read_exact(&mut params).await {
                error!("Failed to read FastCGI params: {}", e);
                return;
            }

            let params_map = parse_params(&params);
            let script_filename = params_map.get("SCRIPT_FILENAME").cloned().unwrap_or_else(|| "/var/www/html/index.php".to_string());

            // Create and send ExecutePhp message
            let execute_msg = ExecutePhp {
                script: script_filename.clone(),
                params: params_map.clone(),
            };

            let response = php_executor.send(execute_msg).await;

            match response {
                Ok(Ok(stdout)) => {
                    // Send STDOUT
                    let fcgi_stdout = FcgiResponse::new(
                        FCGI_VERSION_1,
                        FCGI_STDOUT,
                        header.request_id,
                        stdout.into_bytes(),
                    );
                    if let Err(e) = stream.write_all(&fcgi_stdout.to_bytes()).await {
                        error!("Failed to write FCGI_STDOUT: {}", e);
                        return;
                    }

                    // Send END_REQUEST
                    let fcgi_end_request = FcgiResponse::new(
                        FCGI_VERSION_1,
                        FCGI_END_REQUEST,
                        header.request_id,
                        vec![0, 0, 0, 0, crate::fastcgi::FCGI_REQUEST_COMPLETE, 0, 0, 0],
                    );
                    if let Err(e) = stream.write_all(&fcgi_end_request.to_bytes()).await {
                        error!("Failed to write FCGI_END_REQUEST: {}", e);
                        return;
                    }
                }
                Ok(Err(err_msg)) => {
                    error!("PHP Execution Error: {}", err_msg);
                    // Send STDERR
                    let fcgi_stderr = FcgiResponse::new(
                        FCGI_VERSION_1,
                        crate::fastcgi::FCGI_STDERR,
                        header.request_id,
                        err_msg.into_bytes(),
                    );
                    if let Err(e) = stream.write_all(&fcgi_stderr.to_bytes()).await {
                        error!("Failed to write FCGI_STDERR: {}", e);
                        return;
                    }

                    // Send END_REQUEST with status
                    let fcgi_end_request = FcgiResponse::new(
                        FCGI_VERSION_1,
                        FCGI_END_REQUEST,
                        header.request_id,
                        vec![0, 0, 0, 0, crate::fastcgi::FCGI_REQUEST_COMPLETE, 0, 0, 0],
                    );
                    if let Err(e) = stream.write_all(&fcgi_end_request.to_bytes()).await {
                        error!("Failed to write FCGI_END_REQUEST: {}", e);
                        return;
                    }
                }
                Err(e) => {
                    error!("Failed to send ExecutePhp message: {}", e);
                    return;
                }
            }
        }.into_actor(self))
    }
}
```

#### **Explanation**

- **`HandleConnection` Message**: Carries a new FastCGI connection (`UnixStream`).
- **`Worker` Actor**: Receives `HandleConnection` messages, parses FastCGI requests, extracts `SCRIPT_FILENAME`, and delegates execution to the `PhpExecutor` actor.
- **Response Handling**:
  - On success, sends `FCGI_STDOUT` with the PHP output followed by `FCGI_END_REQUEST`.
  - On failure, sends `FCGI_STDERR` with the error message followed by `FCGI_END_REQUEST`.

---

#### **`src/main.rs`**

```rust
// src/main.rs

mod fastcgi;
mod actor;
mod worker;

use actix::prelude::*;
use tokio::net::UnixListener;
use log::{info, error};
use rand::Rng;
use worker::Worker;
use actor::PhpExecutor;

#[actix_rt::main]
async fn main() -> std::io::Result<()> {
    // Initialize logger
    env_logger::init();

    // Start PhpExecutor actor
    let php_executor = PhpExecutor::new().start();

    // Start a pool of Worker actors
    let num_workers = num_cpus::get(); // Number of CPU cores
    let mut workers = Vec::new();

    for _ in 0..num_workers {
        let worker = Worker::new(php_executor.clone()).start();
        workers.push(worker);
    }

    // Bind to UNIX socket
    let socket_path = "/tmp/rust_fastcgi.sock";
    // Remove existing socket file if any
    if std::path::Path::new(socket_path).exists() {
        std::fs::remove_file(socket_path)?;
    }

    let listener = UnixListener::bind(socket_path)?;
    info!("Rust FastCGI Worker listening on {}", socket_path);

    loop {
        match listener.accept().await {
            Ok((stream, _addr)) => {
                info!("Accepted new connection");

                // Select a worker in a round-robin fashion
                let mut rng = rand::thread_rng();
                let worker = workers[rng.gen_range(0..workers.len())].clone();

                // Send HandleConnection message to the worker
                worker.do_send(worker::HandleConnection { stream });
            }
            Err(e) => {
                error!("Failed to accept connection: {}", e);
                continue;
            }
        }
    }
}
```

#### **Explanation**

- **Logger Initialization**: Sets up logging using `env_logger`.
- **`PhpExecutor` Actor**: Starts the PHP execution handler.
- **Worker Pool**: Spawns a number of `Worker` actors equal to the number of CPU cores for concurrent handling.
- **UNIX Socket Binding**: Listens on `/tmp/rust_fastcgi.sock` for incoming FastCGI connections.
- **Connection Handling**: Accepts new connections and delegates them to workers in a random selection to distribute load.

